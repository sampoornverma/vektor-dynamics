# Server Configuration
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Database Configuration (MongoDB)
# Replace with your local or MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/vektor_dynamics

# SMTP Configuration (Nodemailer)
# Direct mailing configuration without 3rd party SaaS dependencies
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_PASS=your_gmail_app_password

# Notification Target Inbox
CONTACT_RECEIVER_EMAIL=your_inbox@gmail.com
